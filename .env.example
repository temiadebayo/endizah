# Site configuration
# Set to "production" on the live domain so robots.txt allows indexing.
# Any other value (preview, staging, development) prevents search indexing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_ENV=development

# Sanity CMS (leave empty to preview the site with built-in approved fallback copy)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-05-01
SANITY_API_READ_TOKEN=
SANITY_PREVIEW_SECRET=

# Enquiry delivery (server-side only — never expose to client bundles)
# When RESEND_API_KEY and ENQUIRY_RECIPIENT_EMAIL are set, form enquiries are delivered via Resend.
RESEND_API_KEY=
ENQUIRY_RECIPIENT_EMAIL=
ENQUIRY_FROM_EMAIL=
